{
  "name": "newai",
  "version": "0.1.0",
  "description": "Claude Code를 감싸는 개발 자동화 하네스",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "harness": "bin/harness.js"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/unit/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "e2e:decision": "node tests/e2e/decision.e2e.ts claude-haiku-5-5 default && node tests/e2e/decision.e2e.ts claude-haiku-5-5 script"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2"
  }
}
