# ── `npm run dev` / `npm run db:init` 용 (.env.local 로 복사) ──
# Postgres 접속 주소. Supabase 는 Connect > Session pooler 주소(포트 5432)를 넣습니다.
DATABASE_URL=postgresql://postgres.프로젝트ID:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# 로그인 쿠키 서명용 임의 문자열. 32자 이상 무작위 값을 넣으세요.
SESSION_SECRET=여기에-길고-무작위인-문자열

# 관리자 화면 비밀번호
ADMIN_PASSWORD=관리자-비밀번호
