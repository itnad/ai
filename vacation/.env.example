# Postgres 접속 주소. Supabase는 Project Settings > Database > Connection string > Transaction pooler 값을 그대로 붙여넣습니다.
DATABASE_URL=postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 로그인 쿠키 서명용 임의 문자열. 32자 이상 무작위 값을 넣으세요.
SESSION_SECRET=여기에-길고-무작위인-문자열

# 관리자 화면 비밀번호
ADMIN_PASSWORD=관리자-비밀번호
